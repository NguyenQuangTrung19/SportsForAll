// Prisma schema for SportsForAll
// Tài liệu yêu cầu: ../../../Idea.md

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  user
  business
  admin
}

enum SkillLevel {
  beginner
  amateur
  intermediate
  advanced
  pro
}

enum TeamRole {
  captain
  co_captain
  member
}

enum RecruitmentStatus {
  open
  closed
}

enum JoinRequestStatus {
  pending
  accepted
  rejected
  cancelled
}

enum MatchRequestStatus {
  open
  matched
  cancelled
  expired
}

enum ChallengeStatus {
  pending
  accepted
  rejected
  withdrawn
}

enum MatchStatus {
  scheduled
  completed
  cancelled
}

/// Bao co mat cho mot tran da chot lich. Ngoai SRS goc — them de dashboard
/// tra loi duoc cau "ai da bao co mat".
enum AttendanceStatus {
  going
  not_going
}

/// Buoi trong ngay cua mot loi moi tim tran (FR-005.5). Suy ra tu preferredTime
/// theo gio Viet Nam roi luu lai — Prisma khong loc duoc theo gio-trong-ngay.
enum TimeSlot {
  morning
  afternoon
  evening
}

/// Ly do bao cao mot doi (FR-005.11).
enum ReportReason {
  no_show
  violence
  abusive_language
  cheating
  other
}

enum ReportStatus {
  pending
  reviewed
  dismissed
}

/// Trang thai mot san (FR-008.2, FR-010.5). `suspended` la admin tam dinh chi:
/// san bien khoi danh sach cong khai nhung du lieu dat san cu van con nguyen.
enum VenueStatus {
  active
  suspended
}

/// Mot khung gio cua san (FR-008.3). `blocked` la chu san tu chan (bao tri, giai dau).
enum SlotStatus {
  open
  booked
  blocked
}

enum BookingStatus {
  pending
  confirmed
  rejected
  cancelled
}

enum NotificationType {
  join_request_received
  join_request_accepted
  join_request_rejected
  challenge_received
  challenge_accepted
  challenge_rejected
  match_scheduled
  match_reminder
  rating_received
  team_invite_received
  team_invite_accepted
  team_invite_rejected
  booking_requested
  booking_confirmed
  booking_rejected
  booking_cancelled
}

/// Danh muc mon the thao. Truoc day la enum Postgres nen admin khong them duoc
/// mon moi luc chay; gio la bang de quan tri qua giao dien.
model Sport {
  slug        String   @id
  nameVi      String
  primary     String
  primaryDark String
  /// Icon do admin tai len. Null thi web dung icon SVG dung san theo slug.
  iconUrl     String?
  positions   String[]
  sortOrder   Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sportPreferences SportPreference[]
  teams            Team[]
  venues           Venue[]
  recruitmentPosts RecruitmentPost[]
  matchRequests    MatchRequest[]
  matches          Match[]
  lookingForPosts  LookingForTeamPost[]
  landingImage     LandingImage?

  @@index([active, sortOrder])
}

model User {
  id            String    @id @default(cuid())
  /// Null khi dang ky bang so dien thoai (FR-001.2). Postgres cho nhieu NULL
  /// cung ton tai duoi rang buoc unique.
  email         String?   @unique
  /// Luon luu dang 0xxxxxxxxx (xem normalizePhone o @sfa/shared).
  phone         String?   @unique
  /// Da chung minh so hu `phone` bang OTP. Chi so da xac thuc moi dang nhap
  /// duoc bang OTP — so tu go vao ho so thi chua.
  phoneVerified Boolean   @default(false)
  passwordHash  String?
  displayName   String
  avatarUrl     String?
  bio           String?
  birthYear     Int?
  region        String?
  role          UserRole  @default(user)
  /// Uy tin ca nhan (FR-002.12), tinh lai trong lib/reputation.ts moi khi co phieu cham.
  reputation    Float     @default(0)
  /// So tran da duoc cham ma nguoi nay bao "going" — mau so cua `reputation`.
  ratedMatches  Int       @default(0)
  emailVerified Boolean   @default(false)
  /// Khac null = tai khoan bi khoa (FR-010.7). Dung timestamp thay vi co boolean
  /// vi admin luon phai tra loi duoc cau "khoa tu bao gio".
  disabledAt    DateTime?
  onboardedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  refreshTokens    RefreshToken[]
  authTokens       AuthToken[]
  oauthAccounts    OAuthAccount[]
  sportPreferences SportPreference[]
  teamMemberships  TeamMember[]
  joinRequests     JoinRequest[]
  invitesReceived  TeamInvite[]         @relation("InviteTarget")
  invitesSent      TeamInvite[]         @relation("InviteSender")
  venues           Venue[]
  bookings         Booking[]
  venueReviews     VenueReview[]
  notifications    Notification[]
  lookingForPosts  LookingForTeamPost[]
  landingImages    LandingImage[]
  attendances      MatchAttendance[]
  matchScores      PlayerMatchScore[]
  ratingsGiven     Rating[]
  reportsFiled     Report[]

  @@index([region])
  @@index([disabledAt])
}

model SportPreference {
  id         String     @id @default(cuid())
  userId     String
  sport      String
  sportRef   Sport      @relation(fields: [sport], references: [slug], onDelete: Restrict)
  skillLevel SkillLevel
  position   String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, sport])
  @@index([sport, skillLevel])
}

model Team {
  id          String      @id @default(cuid())
  name        String
  sport       String
  sportRef    Sport       @relation(fields: [sport], references: [slug], onDelete: Restrict)
  region      String?
  description String?
  logoUrl     String?
  skillLevel  SkillLevel?
  reputation  Float       @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  members          TeamMember[]
  invites          TeamInvite[]
  recruitmentPosts RecruitmentPost[]
  matchRequests    MatchRequest[]
  challenges       Challenge[]
  matchesAsHome    Match[]           @relation("HomeTeam")
  matchesAsAway    Match[]           @relation("AwayTeam")
  ratingsReceived  Rating[]
  reportsAgainst   Report[]
  bookings         Booking[]
  attendances      MatchAttendance[]
  matchScores      TeamMatchScore[]

  @@index([sport, region])
  @@index([sport, skillLevel])
}

model RecruitmentPost {
  id             String            @id @default(cuid())
  teamId         String
  sport          String
  sportRef       Sport             @relation(fields: [sport], references: [slug], onDelete: Restrict)
  region         String?
  positionNeeded String?
  skillLevelMin  SkillLevel?
  description    String
  status         RecruitmentStatus @default(open)
  expiresAt      DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  team     Team          @relation(fields: [teamId], references: [id], onDelete: Cascade)
  requests JoinRequest[]

  @@index([sport, region, status])
  @@index([teamId, status])
  @@index([status, createdAt])
}

model JoinRequest {
  id        String            @id @default(cuid())
  postId    String
  userId    String
  status    JoinRequestStatus @default(pending)
  message   String?
  createdAt DateTime          @default(now())
  decidedAt DateTime?

  post RecruitmentPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([userId, status])
}

/// Chieu nguoc lai cua JoinRequest (FR-006.8): doi chu dong moi nguoi choi.
/// Khong dung chung bang voi JoinRequest vi loi moi khong gan voi bai tuyen nao
/// — postId se phai nullable va @@unique([postId, userId]) mat tac dung.
/// Dung lai JoinRequestStatus: vong doi hai ben giong het nhau.
model TeamInvite {
  id          String            @id @default(cuid())
  teamId      String
  userId      String
  /// Ai bam moi — de hien "X da moi ban vao doi Y" va truy nguoc khi co tranh cai.
  invitedById String
  status      JoinRequestStatus @default(pending)
  message     String?
  createdAt   DateTime          @default(now())
  decidedAt   DateTime?

  team      Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User @relation("InviteTarget", fields: [userId], references: [id], onDelete: Cascade)
  invitedBy User @relation("InviteSender", fields: [invitedById], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([userId, status])
  @@index([teamId, status])
}

model MatchRequest {
  id            String             @id @default(cuid())
  teamId        String
  sport         String
  sportRef      Sport              @relation(fields: [sport], references: [slug], onDelete: Restrict)
  region        String?
  preferredTime DateTime?
  venueName     String?
  description   String
  status        MatchRequestStatus @default(open)
  skillLevelMin SkillLevel?
  timeSlot      TimeSlot?
  expiresAt     DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  team       Team        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  challenges Challenge[]
  match      Match?

  @@index([sport, region, status])
  @@index([teamId, status])
  @@index([status, createdAt])
  @@index([status, timeSlot])
}

model Challenge {
  id               String          @id @default(cuid())
  matchRequestId   String
  challengerTeamId String
  message          String?
  status           ChallengeStatus @default(pending)
  createdAt        DateTime        @default(now())
  decidedAt        DateTime?

  matchRequest   MatchRequest @relation(fields: [matchRequestId], references: [id], onDelete: Cascade)
  challengerTeam Team         @relation(fields: [challengerTeamId], references: [id], onDelete: Cascade)

  @@unique([matchRequestId, challengerTeamId])
  @@index([challengerTeamId, status])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String?
  link      String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

model Match {
  id             String      @id @default(cuid())
  matchRequestId String?     @unique
  homeTeamId     String
  awayTeamId     String
  sport          String
  sportRef       Sport       @relation(fields: [sport], references: [slug], onDelete: Restrict)
  scheduledAt    DateTime?
  venueName      String?
  status         MatchStatus @default(scheduled)
  homeScore      Int?
  awayScore      Int?
  /// Da gui nhac tran sap dien ra (FR-009.4). Dat truoc khi gui de moi tran chi
  /// nhac mot lan, ke ca khi chay nhieu instance.
  reminderSentAt DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  matchRequest MatchRequest?     @relation(fields: [matchRequestId], references: [id], onDelete: SetNull)
  homeTeam     Team              @relation("HomeTeam", fields: [homeTeamId], references: [id], onDelete: Cascade)
  awayTeam     Team              @relation("AwayTeam", fields: [awayTeamId], references: [id], onDelete: Cascade)
  attendances  MatchAttendance[]
  ratings      Rating[]
  reports      Report[]

  @@index([homeTeamId, status])
  @@index([awayTeamId, status])
  @@index([sport, scheduledAt])
  @@index([status, reminderSentAt, scheduledAt])
}

/// Mot dong = mot thanh vien tra loi cho mot tran. Khong co dong = chua tra loi,
/// nen "chua tra loi" luon suy ra tu si so doi chu khong luu san.
model MatchAttendance {
  id        String           @id @default(cuid())
  matchId   String
  userId    String
  /// Doi nguoi nay da ra san cho. Luu lai vi roi doi thi TeamMember mat, ma uy
  /// tin ca nhan van phai biet tran cu minh da ra san cho ai.
  teamId    String
  status    AttendanceStatus
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  team  Team  @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([matchId, userId])
  @@index([matchId, status])
  @@index([userId, status])
}

/// Bai "Tim doi" do ca nhan dang — chieu nguoc lai voi RecruitmentPost (doi tuyen nguoi).
model LookingForTeamPost {
  id          String            @id @default(cuid())
  userId      String
  sport       String
  sportRef    Sport             @relation(fields: [sport], references: [slug], onDelete: Restrict)
  region      String?
  position    String?
  skillLevel  SkillLevel?
  description String
  status      RecruitmentStatus @default(open)
  expiresAt   DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([sport, region, status])
  @@index([userId, status])
  @@index([status, createdAt])
}

/// Anh nen trang gioi thieu, do admin thay. Khong co ban ghi -> web dung anh
/// mac dinh dong kem trong bundle.
model LandingImage {
  id          String   @id @default(cuid())
  sport       String   @unique
  sportRef    Sport    @relation(fields: [sport], references: [slug], onDelete: Restrict)
  largeUrl    String
  smallUrl    String
  tileUrl     String
  updatedById String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  updatedBy User? @relation(fields: [updatedById], references: [id], onDelete: SetNull)
}

model TeamMember {
  id       String   @id @default(cuid())
  teamId   String
  userId   String
  role     TeamRole @default(member)
  joinedAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([userId])
}

enum OAuthProvider {
  google
  facebook
}

/// Lien ket tai khoan voi Google/Facebook (FR-001.1, 1.4, 1.5). Khoa theo id
/// phia nha cung cap, khong theo email — email ben ho doi duoc.
model OAuthAccount {
  id             String        @id @default(cuid())
  userId         String
  provider       OAuthProvider
  providerUserId String
  createdAt      DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
}

enum AuthTokenPurpose {
  email_verify
  password_reset
  phone_otp
  oauth_login
  oauth_link
}

/// Ma dung mot lan: link trong email (1.6, 1.7), OTP (1.2), ma doi phien sau
/// OAuth. Chi luu hash. `target` la email/so dien thoai luc phat ma — OTP dang
/// ky chua co user nen phai tra theo target.
model AuthToken {
  id        String           @id @default(cuid())
  purpose   AuthTokenPurpose
  userId    String?
  target    String
  tokenHash String
  attempts  Int              @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime         @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@index([purpose, target])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Nhat ky thao tac quan tri (FR-010.8). Chi ghi thao tac lam doi du lieu —
/// ghi ca luot doc thi log tu no thanh feed rac khong ai xem.
///
/// `adminId` / `adminName` la anh chup, khong phai khoa ngoai: xoa tai khoan
/// admin khong duoc phep xoa mat dau vet ho da lam gi.
model AdminAction {
  id         String   @id @default(cuid())
  adminId    String
  adminName  String
  action     String
  targetType String
  targetId   String
  detail     String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([adminId, createdAt])
}

/// Danh gia uy tin sau tran (FR-005.10). Moi nguoi mot phieu cho moi tran, cham
/// doi doi dien. Diem tung tran ghi vao so TeamMatchScore / PlayerMatchScore, uy
/// tin tinh tu so (lib/reputation.ts) de doi thu giai tan khong xoa mat phieu.
model Rating {
  id          String   @id @default(cuid())
  matchId     String
  raterId     String
  ratedTeamId String
  score       Int
  comment     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  match     Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  rater     User  @relation(fields: [raterId], references: [id], onDelete: Cascade)
  ratedTeam Team  @relation(fields: [ratedTeamId], references: [id], onDelete: Cascade)

  @@unique([matchId, raterId])
  @@index([ratedTeamId])
}

/// So diem uy tin doi (FR-007.7), cung ly do voi PlayerMatchScore ben duoi: doi
/// thu giai tan thi Match/Rating mat, nhung phieu doi minh da nhan phai con.
model TeamMatchScore {
  teamId    String
  matchId   String
  score     Float
  updatedAt DateTime @updatedAt

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@id([teamId, matchId])
}

/// So diem uy tin ca nhan (FR-002.12): mot dong = diem cua mot nguoi trong mot tran.
/// `matchId` co y KHONG co khoa ngoai — doi giai tan thi tran bi xoa day chuyen,
/// nhung lich su da ra san khong duoc mat theo (va giai tan khong duoc la cach xoa
/// phieu xau cho ca doi).
model PlayerMatchScore {
  userId    String
  matchId   String
  score     Float
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, matchId])
}

/// Bao cao doi vi pham (FR-005.11). Giu nguyen ban ghi khi tran bi xoa
/// (matchId SetNull) vi bao cao la bang chung, khong phai phu luc cua tran.
model Report {
  id             String       @id @default(cuid())
  reporterId     String
  reportedTeamId String
  matchId        String?
  reason         ReportReason
  detail         String?
  status         ReportStatus @default(pending)
  createdAt      DateTime     @default(now())
  resolvedAt     DateTime?

  reporter     User   @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  reportedTeam Team   @relation(fields: [reportedTeamId], references: [id], onDelete: Cascade)
  match        Match? @relation(fields: [matchId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([reportedTeamId, status])
}

/// San bai do tai khoan doanh nghiep dang (FR-008.2).
///
/// `rating` la trung binh cac phieu trong VenueReview, ghi san vao day de danh
/// sach loc/sap xep khong phai tinh lai moi lan doc — dung cach da lam voi
/// Team.reputation.
model Venue {
  id           String      @id @default(cuid())
  ownerId      String
  name         String
  sport        String
  sportRef     Sport       @relation(fields: [sport], references: [slug], onDelete: Restrict)
  address      String
  region       String?
  description  String?
  photoUrl     String?
  /// Gia niem yet moi gio, don vi VND. Int vi tien VND khong co phan le.
  pricePerHour Int
  rating       Float       @default(0)
  status       VenueStatus @default(active)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  owner   User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  slots   VenueSlot[]
  reviews VenueReview[]

  @@index([sport, region, status])
  @@index([ownerId])
  @@index([status, rating])
}

/// Mot khung gio cho thue (FR-008.3).
///
/// Gia nam o tung khung chu khong chi o san: gio vang dat hon gio trua la
/// chuyen binh thuong, va gia da chot cua khung khong duoc doi theo khi chu san
/// sua gia niem yet (FR-008.4).
model VenueSlot {
  id           String     @id @default(cuid())
  venueId      String
  startsAt     DateTime
  endsAt       DateTime
  price        Int
  status       SlotStatus @default(open)
  /// Chu san mo khung nay cho ca doi le vao ghep (FR-008.7, FR-004.4).
  openForTeams Boolean    @default(false)
  note         String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  venue    Venue     @relation(fields: [venueId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@index([venueId, startsAt])
  @@index([status, startsAt])
  @@index([openForTeams, status, startsAt])
}

/// Yeu cau dat san (FR-008.5).
///
/// Nhieu nguoi cung xin mot khung la binh thuong — chu san chon mot, phan con
/// lai tu dong bi tu choi, dung nhu cach Challenge lam voi mot loi moi tim tran.
/// Khoa duy nhat theo (slot, user) de mot nguoi khong spam mot khung; xin lai
/// sau khi bi tu choi la lam moi chinh ban ghi cu.
model Booking {
  id        String        @id @default(cuid())
  slotId    String
  userId    String
  teamId    String?
  status    BookingStatus @default(pending)
  note      String?
  createdAt DateTime      @default(now())
  decidedAt DateTime?

  slot VenueSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  team Team?     @relation(fields: [teamId], references: [id], onDelete: SetNull)

  @@unique([slotId, userId])
  @@index([slotId, status])
  @@index([userId, status])
}

/// Danh gia san (FR-008.8). Mot phieu moi nguoi moi san, sua duoc — giong het
/// Rating cham doi, nen diem san khong bom len duoc bang cach gui nhieu lan.
model VenueReview {
  id        String   @id @default(cuid())
  venueId   String
  userId    String
  score     Int
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([venueId, userId])
  @@index([venueId])
}

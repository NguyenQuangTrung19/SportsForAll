NODE_ENV=development
PORT=4000

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sportsforall?schema=public

# JWT
JWT_ACCESS_SECRET=change-me-in-production-access
JWT_REFRESH_SECRET=change-me-in-production-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# CORS - comma-separated origins
CORS_ORIGINS=http://localhost:5173

# So reverse proxy dung truoc API (nginx, Render, Railway...).
# 0 = phoi truc tiep. Dat sai thi rate limit tinh nham IP.
TRUST_PROXY=0

# Logging
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Dang ky & xac thuc (FR-001). TAT CA LA TUY CHON — xem RUNBOOK muc 7.
# Bo trong thi: luc dev, email va ma OTP in ra terminal dang chay `pnpm dev`;
# luc production, chuc nang do tat va nut tuong ung tu an tren giao dien.
# ---------------------------------------------------------------------------

# Dia chi cong khai — dung de dung link trong email va redirect OAuth.
WEB_URL=http://localhost:5173
API_URL=http://localhost:4000

# Gui email (quen mat khau, xac thuc email) — https://resend.com
RESEND_API_KEY=
# MAIL_FROM=SportsForAll <no-reply@ten-mien-cua-ban.vn>

# Gui SMS OTP (dang ky bang so dien thoai) — https://twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Dang nhap Google — Redirect URI: {API_URL}/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Dang nhap Facebook — Redirect URI: {API_URL}/api/auth/oauth/facebook/callback
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Web Push — sinh mot lan: pnpm --filter @sfa/api exec web-push generate-vapid-keys
# Doi cap khoa lam mat moi dang ky da co (nguoi dung phai bat lai).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
